# Application Environment
APP_NAME="Purbo Nijmaona Fakir Bari"
APP_ENV="production"
APP_DEBUG="false"
APP_URL="http://localhost:8000"

# Session Security
SESSION_NAME="village_admin_session"
SESSION_SECURE_COOKIE="true"
SESSION_IDLE_TIMEOUT="1800"
SESSION_ABSOLUTE_TIMEOUT="28800"

# Supabase PostgreSQL Connection (PDO_PGSQL)
# Supports Direct Connection (port 5432, user=postgres) or Transaction Pooler (port 6543, user=postgres.YOUR_PROJECT_REF).
# Or set DATABASE_URL="postgresql://..." directly.
SUPABASE_DB_HOST="aws-0-ap-northeast-2.pooler.supabase.com"
SUPABASE_DB_PORT="6543"
SUPABASE_DB_NAME="postgres"
SUPABASE_DB_USER="postgres.YOUR_PROJECT_REF"
SUPABASE_DB_PASSWORD="CHANGE_ME_STRONG_DB_PASSWORD"
SUPABASE_DB_SSLMODE="require"

# Supabase Storage REST API (server-side PHP ONLY - never expose in frontend JS)
# Preferred: Supabase Secret API key (sb_secret_...). Keep it only in this server-side .env file.
# Backward compatible: legacy service_role JWT can still be supplied as SUPABASE_STORAGE_KEY.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="CHANGE_ME_SUPABASE_SECRET_KEY"
# Optional legacy variable name (used only when SUPABASE_SECRET_KEY is empty):
# SUPABASE_STORAGE_KEY="CHANGE_ME_LEGACY_SERVICE_ROLE_KEY"

# Storage Bucket Names
BUCKET_WEBSITE_ASSETS="website-assets"
BUCKET_HERO_BANNERS="hero-banners"
BUCKET_GALLERY_IMAGES="gallery-images"
BUCKET_POST_MEDIA="post-media"

# Optional Mail Transport for Admin Password Recovery Links
MAIL_ENABLED="false"
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="Purbo Nijmaona Fakir Bari"

# AI Studio Runtime Environment Variables (optional in local PHP deployment)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
